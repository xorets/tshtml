{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2015",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["es2017", "dom"]
  },
  "include": [
    "spec/**/*.ts"
  ]
}
